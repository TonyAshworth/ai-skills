#!/bin/bash
set -e

# Install script for ai-skills
# Builds skills and generates the registry

REPO_ROOT="$( cd "$( dirname "${BASH_SOURCE[0]}" )/.." > /dev/null 2>&1 && pwd )"
SKILLS_DIR="$REPO_ROOT/skills"
DIST_DIR="$REPO_ROOT/dist"
REGISTRY_FILE="$REPO_ROOT/skills.json"

# Create dist directory
mkdir -p "$DIST_DIR"

# Generate registry by scanning skills directory
echo "Generating skills registry..."

# Start with an empty array
registry='{"skills": []}'

# Process each skill directory
for skill_dir in "$SKILLS_DIR"/*; do
  if [ -d "$skill_dir" ] && [ -f "$skill_dir/SKILL.md" ]; then
    skill_name=$(basename "$skill_dir")
    skill_file="$skill_dir/SKILL.md"

    # Extract name from frontmatter (between --- markers)
    name=$(sed -n '/^name:/{s/^name:[[:space:]]*//; s/[[:space:]]*$//; p;}' "$skill_file" | head -1)

    # Extract description from frontmatter
    description=$(sed -n '/^description:/{s/^description:[[:space:]]*//; s/[[:space:]]*$//; p;}' "$skill_file" | head -1)

    # Use skill_name if name not found in frontmatter
    if [ -z "$name" ]; then
      name="$skill_name"
    fi

    # Create registry entry using jq (use relative path)
    relative_path="skills/${skill_name}/SKILL.md"
    registry=$(jq \
      --arg name "$name" \
      --arg description "$description" \
      --arg path "$relative_path" \
      '.skills += [{name: $name, description: $description, path: $path}]' \
      <<< "$registry")
  fi
done

# Write registry
echo "$registry" | jq '.' > "$REGISTRY_FILE"
echo "✓ Registry generated: $REGISTRY_FILE"

# Copy skills to dist (for now, just reference the source)
cp -r "$SKILLS_DIR" "$DIST_DIR/" 2>/dev/null || true

echo "✓ Installation complete"
echo ""
echo "Available skills:"
jq -r '.skills[] | "  - \(.name): \(.description)"' "$REGISTRY_FILE"
